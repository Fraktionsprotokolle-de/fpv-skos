# Beispieldatei (fiktiv) – 20 Konzepte mit skos:related-Verknüpfungen
@prefix ex:  <https://voc.fraktionsprotokolle.de/id/> .
@prefix fpv: <https://voc.fraktionsprotokolle.de/schema/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# ------------------------------------------------------------
# FPV Datenmodell (Kurzprofil)
# - Alle Einträge sind skos:Concept.
# - Die lokale ID steht in der URI: ex:{ID}
# - Klassifikation über skos:notation als typisiertes Literal:
#     skos:notation "{code}"^^fpv:entityType
# - Zulässige Codes (entityType): siehe fpv:entityTypeNote unten.
# - Verwandte Konzepte können über skos:related verknüpft werden:
#     skos:related ex:AndereID , ex:NochEineID .
#   Hinweis: skos:related ist symmetrisch – wird die Beziehung
#   in eine Richtung angegeben, gilt sie auch umgekehrt.
# ------------------------------------------------------------

fpv:entityType a rdfs:Datatype ;
  rdfs:label "FPV entity type code"@en ;
  rdfs:label "FPV-Entitätstyp (Code)"@de ;
  rdfs:comment "Datatype for controlled, short classification codes used in skos:notation, e.g. \"org\"^^fpv:entityType."@en ;
  rdfs:comment "Datentyp für kontrollierte, kurze Klassifikationscodes in skos:notation, z. B. \"org\"^^fpv:entityType."@de .

# Dokumentation der zulässigen Codes (nicht maschinell erzwungen).
fpv:entityTypeNote a skos:Concept ;
  skos:prefLabel "Zulässige entityType-Codes (Dokumentation)"@de ;
  skos:note """
org    = Organisation / Institution / Verband / Gremium
com    = Unternehmen / Wirtschaft (falls benötigt)
news   = Presse / Zeitung / Medium (falls benötigt)
topic  = Sachbegriff / Thema (z. B. "Mülltrennung")
law    = Gesetz / Rechtsnorm (falls benötigt)
pol    = Partei / politische Gruppierung (falls benötigt)

Zusätzliche Relationen:
skos:related = Verweis auf thematisch verwandte Konzepte innerhalb des FPV
"""@de .


# === 20 fiktive Beispielkonzepte ===

ex:NATO a skos:Concept ;
  skos:prefLabel "North Atlantic Treaty Organization"@de ;
  skos:altLabel "NATO"@de ;
  skos:notation "org"^^fpv:entityType ;
  ex:useInSynonymList "true"^^xsd:boolean ;
  skos:exactMatch <http://d-nb.info/gnd/2006524-8> ;
  skos:closeMatch <https://de.wikipedia.org/wiki/NATO> ;
  skos:related ex:Bundeswehr , ex:WEU , ex:Wiederbewaffnung ;
  skos:note "Westliches Verteidigungsbündnis, gegründet 1949."@de .

ex:Bundeswehr a skos:Concept ;
  skos:prefLabel "Bundeswehr"@de ;
  skos:notation "org"^^fpv:entityType ;
  ex:useInSynonymList "false"^^xsd:boolean ;
  skos:exactMatch <http://d-nb.info/gnd/2116728-X> ;
  skos:closeMatch <https://de.wikipedia.org/wiki/Bundeswehr> ;
  skos:related ex:NATO , ex:Wiederbewaffnung , ex:BMVg ;
  skos:note "Streitkräfte der Bundesrepublik Deutschland."@de .

ex:Wiederbewaffnung a skos:Concept ;
  skos:prefLabel "Wiederbewaffnung"@de ;
  skos:notation "topic"^^fpv:entityType ;
  ex:useInSynonymList "false"^^xsd:boolean ;
  skos:closeMatch <https://de.wikipedia.org/wiki/Wiederbewaffnung> ;
  skos:related ex:NATO , ex:Bundeswehr , ex:EVG ;
  skos:note "Debatte über die Wiederaufstellung deutscher Streitkräfte nach 1945."@de .

ex:EVG a skos:Concept ;
  skos:prefLabel "Europäische Verteidigungsgemeinschaft"@de ;
  skos:altLabel "EVG"@de ;
  skos:notation "org"^^fpv:entityType ;
  ex:useInSynonymList "true"^^xsd:boolean ;
  skos:exactMatch <http://d-nb.info/gnd/4015720-7> ;
  skos:closeMatch <https://de.wikipedia.org/wiki/Europ%C3%A4ische_Verteidigungsgemeinschaft> ;
  skos:related ex:Wiederbewaffnung , ex:WEU ;
  skos:note "Gescheitertes Projekt einer gemeinsamen europäischen Armee (1952–1954)."@de .

ex:WEU a skos:Concept ;
  skos:prefLabel "Westeuropäische Union"@de ;
  skos:altLabel "WEU"@de ;
  skos:notation "org"^^fpv:entityType ;
  ex:useInSynonymList "true"^^xsd:boolean ;
